# ==============================================================================
# PHOTOMAGIC STUDIO OS - MONOREPO ENVIRONMENT TEMPLATE
# ==============================================================================

# Supabase Managed Database & Auth Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Cloudinary Media Storage Credentials
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_URL=cloudinary://your-cloudinary-api-key:your-cloudinary-api-secret@your-cloudinary-cloud-name

# Razorpay Payment Gateway Credentials
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# AI Intelligence APIs (Google Gemini, Imagen 3 & Hugging Face)
GEMINI_API_KEY=your-google-gemini-api-key
GOOGLE_VISION_API_KEY=your-google-vision-api-key
HUGGINGFACE_API_KEY=hf_your_free_huggingface_token

# Google Maps API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Upstash Redis (Rate Limiting & Webhook Idempotency)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token
