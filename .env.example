# ==============================================================================
# PHOTOMAGIC STUDIO OS - MONOREPO ENVIRONMENT TEMPLATE
# ==============================================================================

# Supabase Managed Database & Auth Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Cloudflare R2 Object Storage Credentials
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-cloudflare-r2-access-key
R2_SECRET_ACCESS_KEY=your-cloudflare-r2-secret-key
R2_BUCKET_RAW=photomagic-raw-dev
R2_BUCKET_PROOFS=photomagic-proofs-dev
R2_BUCKET_DELIVERIES=photomagic-deliveries-dev
R2_PUBLIC_CUSTOM_DOMAIN=https://media-dev.photomagic.studio

# Razorpay Payment Gateway Credentials
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# AI Intelligence APIs (Google Gemini & Vision)
GEMINI_API_KEY=your-google-gemini-api-key
GOOGLE_VISION_API_KEY=your-google-vision-api-key

# Google Maps API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Upstash Redis (Rate Limiting & Webhook Idempotency)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token
