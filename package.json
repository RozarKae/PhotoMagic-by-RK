{
  "name": "photomagic-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "PhotoMagic Monorepo — Studio Marketing Website & OS Platform",
  "author": "PhotoMagic Engineering Team",
  "license": "MIT",
  "scripts": {
    "dev": "turbo run dev",
    "dev:studio": "turbo run dev --filter=@photomagic/studio",
    "dev:os": "turbo run dev --filter=@photomagic/os",
    "build": "turbo run build",
    "build:studio": "turbo run build --filter=@photomagic/studio",
    "build:os": "turbo run build --filter=@photomagic/os",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "prepare": "husky install"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.25",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5",
    "turbo": "^1.13.0",
    "typescript": "^5.4.5"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  }
}
